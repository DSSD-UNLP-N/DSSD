{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/al_iniciar.py\"", "timeout": 20 } ] }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/antes_de_commit.py\"", "timeout": 600 } ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [ { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger_archivos.py\"", "timeout": 10 } ]
      }
    ]
  }
}
