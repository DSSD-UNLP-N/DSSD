# SQLite para desarrollo local; con Postgres: postgresql+psycopg://usuario:clave@localhost:5432/nacional
DATABASE_URL=sqlite:///./nacional.db
# Debe coincidir con JWT_SECRET de backend/.env; Nacional firma y backend valida.
JWT_SECRET=dev-only-change-me
JWT_EXPIRATION_MINUTES=60
# Crear una cuenta con rol BONITA al ejecutar python -m app.seed.
BONITA_SERVICE_USERNAME=bonita-service
BONITA_SERVICE_PASSWORD=change-me
