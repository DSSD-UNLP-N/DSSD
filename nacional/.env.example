# SQLite para desarrollo local; con Postgres: postgresql+psycopg://usuario:clave@localhost:5432/nacional
DATABASE_URL=sqlite:///./nacional.db
# Nacional firma los tokens y los valida él mismo: la app local y Bonita solo los presentan (no comparten el secreto).
JWT_SECRET=dev-only-change-me
JWT_EXPIRATION_MINUTES=60
# Cuentas de servicio (rol BONITA) que crea python -m app.seed: una para los conectores de Bonita y otra para la app local.
# Con Postgres (la nube) la API no arranca si JWT_SECRET o estas claves quedan con el valor de ejemplo.
BONITA_SERVICE_USERNAME=bonita-service
BONITA_SERVICE_PASSWORD=change-me
APP_SERVICE_USERNAME=app-service
APP_SERVICE_PASSWORD=change-me-app
