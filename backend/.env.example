BONITA_BASE_URL=http://localhost:8080/bonita
BONITA_USERNAME=walter.bates
BONITA_PASSWORD=bpm
BONITA_PROCESS_NAME=Gestion Integral de la Emergencia
BONITA_PROCESS_VERSION=1.0
# Segundos máximos de espera por cada llamada a Bonita
BONITA_TIMEOUT_SECONDS=10
# Postgres del docker-compose de la raíz (docker compose up -d db)
DATABASE_URL=postgresql+psycopg://rescuesync:rescuesync@localhost:5432/rescuesync
# Clave para firmar la cookie de sesión (T-04); cambiar fuera de desarrollo
SESSION_SECRET=dev-only-change-me
# Muestra usuarios y contraseña de demo en el login. Poner en false fuera de desarrollo.
SHOW_DEMO_USERS=true
# API del Sistema Nacional (nacional/): catálogo de recursos y validación de ofertas
# En la nube: NACIONAL_BASE_URL=https://rescuesync-nacional.onrender.com y NACIONAL_SERVICE_PASSWORD = la APP_SERVICE_PASSWORD cargada en Render
NACIONAL_BASE_URL=http://localhost:8002
NACIONAL_TIMEOUT_SECONDS=5
# Cuenta de servicio con la que la app entra a la API Nacional (JWT); la crea `python -m app.seed` de nacional/.
# Contra Render (que duerme y tarda en despertar) subir NACIONAL_TIMEOUT_SECONDS a 60.
NACIONAL_SERVICE_USERNAME=app-service
NACIONAL_SERVICE_PASSWORD=change-me-app
# Ventana provisoria que se manda al instanciar en Bonita (ver CLAUDE.md, duda abierta)
VENTANA_PROVISORIA_HORAS=72
# Clave que los conectores de Bonita mandan en X-Api-Key al llamar a /api/bonita/*; cambiar fuera de desarrollo
BONITA_API_KEY=rescuesync-dev-key
