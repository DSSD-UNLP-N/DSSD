# Alternativa local (fallback): API Nacional en tu PC (nacional/, :8002) con sus claves por defecto, que coinciden con las de entrega42_local.bos.
# Uso:  copy .env.local .env   (Linux/Mac: cp .env.local .env)   y en Bonita importar entrega-3/entrega42_local.bos
BONITA_BASE_URL=http://localhost:8080/bonita
BONITA_USERNAME=walter.bates
BONITA_PASSWORD=bpm
BONITA_PROCESS_NAME=Gestion Integral de la Emergencia
BONITA_PROCESS_VERSION=1.0
BONITA_TIMEOUT_SECONDS=10
DATABASE_URL=sqlite:///./dev.db
SESSION_SECRET=dev-only-change-me
SHOW_DEMO_USERS=true
# API Nacional local.
NACIONAL_BASE_URL=http://localhost:8002
