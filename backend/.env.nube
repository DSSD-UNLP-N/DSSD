# Para usar la API Nacional desplegada en Render (proyecto de facultad: la clave es de la demo).
# Uso:  copy .env.nube .env   (Linux/Mac: cp .env.nube .env)   y en Bonita importar entrega-3/entrega42_nube.bos
BONITA_BASE_URL=http://localhost:8080/bonita
BONITA_USERNAME=walter.bates
BONITA_PASSWORD=bpm
BONITA_PROCESS_NAME=Gestion Integral de la Emergencia
BONITA_PROCESS_VERSION=1.0
BONITA_TIMEOUT_SECONDS=10
DATABASE_URL=sqlite:///./dev.db
SESSION_SECRET=dev-only-change-me
SHOW_DEMO_USERS=true
# API Nacional en la nube. El timeout alto es por el plan gratis de Render: dormido, la primera llamada tarda 30-60 s.
NACIONAL_BASE_URL=https://rescuesync-nacional.onrender.com
NACIONAL_TIMEOUT_SECONDS=90
NACIONAL_SERVICE_USERNAME=app-service
NACIONAL_SERVICE_PASSWORD=1XsI60NapGyzWPakv3hmAH8K
VENTANA_PROVISORIA_HORAS=72
BONITA_API_KEY=rescuesync-dev-key
